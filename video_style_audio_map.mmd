flowchart LR
    request["Requested topic"] --> match["Keyword match against reviewed concept matrix"]
    books["Readable book/course references"] --> concepts["Original concept crosswalk<br/>source IDs; no copied passages"]
    concepts --> matrix["knowledge_matrix.csv<br/>concepts x registered engines"]
    match --> matrix
    matrix --> ranked["Rank engine and authored-lesson links<br/>weights are not calibrated probabilities"]
    ranked --> draw["Seeded weighted lesson selection<br/>only from authored lesson IDs"]
    draw --> batch["Render-ready horizontal/vertical CSV<br/>existing schema; original narration"]

    subgraph knowledge_sources["Readable source scope"]
        fl2["Feynman Physics Vol II<br/>vector-field calculus and electromagnetism"]
        fl3["Feynman Physics Vol III<br/>probability amplitudes; Hamiltonian matrix"]
        fc["Feynman Lectures on Computation<br/>computing and information concepts"]
        qed["Feynman QED<br/>light-matter concepts"]
        cse["Strang MIT 18.085<br/>applied linear algebra; Fourier; finite differences"]
        calculus["Strang MIT 18.001 PDF<br/>course-level calculus reference"]
        sicp["SICP<br/>computing/programming context"]
    end
    fl2 --> concepts
    fl3 --> concepts
    fc --> concepts
    qed --> concepts
    cse --> concepts
    calculus --> concepts
    sicp --> concepts
    fl1["Feynman Physics Vol I file<br/>unreadable: 2-byte invalid DOCX"] -. "excluded until replaced" .-> concepts

    subgraph engine_stack["Existing numerical engine stack"]
        registry["EngineCatalog<br/>all registered math and physics domains"]
        registry --> route["Topic-specific engine weights"]
        route --> simulation["Existing deterministic physics/math calculations"]
        simulation --> visuals["UniversalEngine and Manim scene primitives"]
    end
    matrix --> registry
    batch --> visuals

    subgraph video_references["Local MP4 reference inventory"]
        euler["Euler identity clip<br/>4:07.688; H.264 640x360 30 fps<br/>AAC-LC stereo 44.1 kHz"]
        ode["Differential equations clip<br/>5:38.013; H.264 640x360 30 fps<br/>AAC-LC stereo 44.1 kHz"]
        gaussian["Gaussian sum clip<br/>6:07; H.264 640x360 30 fps<br/>AAC-LC stereo 44.1 kHz"]
        sphere["Sphere-shadow clip<br/>invalid/truncated: 2 bytes"]
    end

    subgraph original_design["Original production mapping; clip style not perceptually analyzed"]
        complex["Complex-plane rotation<br/>animate angle, vector and equation reveal"]
        differential["Slope field / trajectory<br/>synchronize changing state with derivative narration"]
        distribution["Two distributions and their sum<br/>animate overlap, then show resultant curve"]
        audio["Narration-led audio<br/>place equation reads on visual holds;<br/>use sparse original accents and silence"]
        review["Listen and watch at normal speed<br/>approve mix, timing, legibility and physics"]
    end
    euler -. "topic/title only; visual/audio review pending" .-> complex
    ode -. "topic/title only; visual/audio review pending" .-> differential
    gaussian -. "topic/title only; visual/audio review pending" .-> distribution
    sphere -. "replace source before review" .-> review
    complex --> audio
    differential --> audio
    distribution --> audio
    batch --> audio
    audio --> review

    subgraph production_tools["Existing production tools"]
        voice["generate_audio.py"]
        master["soundscape.py"]
        animation["render_universal.py / visual_kit.py"]
        runner["batch_runner.py"]
        voice --> master
        master --> runner
        animation --> runner
    end
    batch --> voice
    visuals --> animation
    runner --> review
